					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.id) {",
							"    pm.collectionVariables.set('clienteId', jsonData.id);",
							"    pm.environment.set('clienteId', jsonData.id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"nombre\": \"Vanessa Mena\",\n  \"email\": \"vanessa.mena@hotel.com\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/clientes",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"clientes"
					]
