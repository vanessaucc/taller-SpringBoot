		{
			"name": "2. Tarea 1 - Consulta Polimórfica de Habitaciones",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Response is an array with polymorphic types\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"    var hasEstandar = jsonData.some(h => h.tipo === 'ESTANDAR');",
							"    var hasSuite = jsonData.some(h => h.tipo === 'SUITE');",
							"    pm.expect(hasEstandar || hasSuite).to.be.true;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/habitaciones",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"habitaciones"
					]
				},
				"description": "Prueba 2: Muestra el array polimórfico con discriminador 'tipo': 'ESTANDAR' / 'SUITE'."
			},
			"response": []
		},
