		{
			"name": "3. Tarea 2 - Resumen Ejecutivo del Cliente",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Calculates total reservas and monto total\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('totalReservasRealizadas');",
							"    pm.expect(jsonData).to.have.property('montoTotalGastado');",
							"    pm.expect(jsonData).to.have.property('reservasRecientes');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/clientes/{{clienteId}}/resumen",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"clientes",
						"{{clienteId}}",
						"resumen"
					]
				},
				"description": "Prueba 3: Proyección agregada con total de reservas, monto gastado calculado por Streams y lista embebida sin ciclos."
			},
			"response": []
		},
		{
			"name": "4. Tarea 3 - Actualización Parcial Segura (PATCH)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Nombre updated without affecting other fields\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.nombre).to.eql(\"Vanessa Mena Modificada\");",
							"    pm.expect(jsonData.email).to.not.be.null;",
							"    pm.expect(jsonData.activo).to.eql(true);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"nombre\": \"Vanessa Mena Modificada\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/clientes/{{clienteId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"clientes",
						"{{clienteId}}"
					]
				},
				"description": "Prueba 4: Modificación selectiva solo del nombre usando NullValuePropertyMappingStrategy.IGNORE."
			},
			"response": []
		},
